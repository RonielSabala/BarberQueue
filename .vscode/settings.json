{
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "editor.formatOnSave": true,
  "prettier.endOfLine": "lf",
  "cSpell.language": "en",
  "cSpell.caseSensitive": true,
  "cSpell.words": ["barberqueue", "dtos", "unwait"],
  "markdown.extension.toc.levels": "2..3",
  "markdown.extension.toc.omittedFromToc": {
    "README.md": ["## Table of Contents"],
    "backend/ROUTES.md": ["## Table of Contents"]
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/tests/.venv/Scripts/python.exe",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[php]": {
    "editor.defaultFormatter": "junstyle.php-cs-fixer"
  },
  "php-cs-fixer.executablePath": "${workspaceFolder}/backend/vendor/bin/php-cs-fixer",
  "php-cs-fixer.config": "backend/.php-cs-fixer.php",
  "php-cs-fixer.allowRisky": true,
  "php-cs-fixer.formatHtml": false,
  "php-imports.formatOnSave": true,
  "php-imports.print.wrap.limit": 88,
  "php-imports.order": [
    "singleUses.class",
    "singleUses.function",
    "singleUses.const",
    "groupedUses.class",
    "groupedUses.function",
    "groupedUses.const"
  ],
  "phpNamespaceResolver.autoSort": true,
  "phpserver.port": 3000,
  "phpserver.relativePath": "backend",
  "phpserver.autoOpenOnReload": false,
  "[sql]": {
    "editor.defaultFormatter": "inferrinizzard.prettier-sql-vscode"
  },
  "Prettier-SQL.SQLFlavourOverride": "mysql",
  "Prettier-SQL.keywordCase": "upper",
  "Prettier-SQL.expressionWidth": 88,
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  }
}
